{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "date '+[%H:%M]'" }] },
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/prune-merged-branches.js\"" }] }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "date '+{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"[%H:%M]\"}}'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "date '+[%H:%M]'" }] }
    ]
  }
}
