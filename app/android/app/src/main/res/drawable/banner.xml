<?xml version="1.0" encoding="utf-8"?>
<!-- The Android TV launcher banner (shown in the Shield's app row): the app icon on gerdTV's dark background.
     A drawable rather than a 320×180 PNG, so it scales on every TV density. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF12121A" />
        </shape>
    </item>
    <item android:gravity="center">
        <bitmap android:src="@mipmap/ic_launcher" android:gravity="center" />
    </item>
</layer-list>
